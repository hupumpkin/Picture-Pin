.DS_Store
Thumbs.db

# Runtime files
*.log
*.pid

# Python cache
__pycache__/
*.py[cod]

# Local environment and secrets
.env
.env.*
!*.env.example
designpeek_dist/.env

# Local Python virtual environment
venv/
designpeek_dist/venv/

# User data generated by DesignPeek
designpeek_dist/screenshots/*
!designpeek_dist/screenshots/_inbox/
designpeek_dist/screenshots/_inbox/*
!designpeek_dist/screenshots/_inbox/.gitkeep

designpeek_dist/data/*
!designpeek_dist/data/.gitkeep
