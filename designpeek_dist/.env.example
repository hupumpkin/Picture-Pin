# ============================================================
# DesignPeek 配置文件 — 复制本文件为 .env 后填写
#   cp .env.example .env
# ============================================================

# 选用哪个 AI 来分析截图:
# gemini / claude / openai / qwen / deepseek / kimi
# 只需配置你选中的那一种,其余留空即可
AI_PROVIDER=gemini


# ── 方案 A:Google Gemini(免费额度大,需 Google 账号)──────────
# 申请地址:https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 可选,覆盖默认视觉模型
# GEMINI_MODEL=gemini-2.5-flash


# ── 方案 B:Claude(公司发放的 Key 或 Anthropic 官方)──────────
ANTHROPIC_API_KEY=
# 走公司网关时填网关地址(官方留空即可);具体地址问团队管理员
# ANTHROPIC_BASE_URL=
# 可选,覆盖默认模型
# ANTHROPIC_MODEL=claude-sonnet-5


# ── 方案 C:GPT(公司网关 / OpenAI 官方)──────────────────────
OPENAI_API_KEY=
# 公司内网网关(仅供参考,以团队实际下发为准):
# OPENAI_BASE_URL=https://llm-gw.jd.local/v1
# 可选,覆盖默认模型(需支持图片输入的视觉模型)
# OPENAI_MODEL=gpt-4.1-mini


# ── 方案 D:Qwen 千问(阿里云百炼) ───────────────────
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen3-vl-plus


# ── 方案 E:DeepSeek(当前使用实验版视觉模型) ────────
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp


# ── 方案 F:Kimi(Moonshot 开放平台) ─────────────
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=kimi-k2.6
