# ============================================================
# DesignPeek 配置文件 — 复制本文件为 .env 后填写
#   cp .env.example .env
# ============================================================

# 选用哪个 AI 来分析截图,三选一:gemini / claude / openai
# 只需配置你选中的那一种,其余留空即可
AI_PROVIDER=gemini


# ── 方案 A:Google Gemini(免费额度大,需 Google 账号)──────────
# 申请地址:https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ── 方案 B:Claude(公司发放的 Key 或 Anthropic 官方)──────────
ANTHROPIC_API_KEY=
# 走公司网关时填网关地址(官方留空即可);具体地址问团队管理员
# ANTHROPIC_BASE_URL=
# 可选,覆盖默认模型
# ANTHROPIC_MODEL=claude-sonnet-4-6


# ── 方案 C:GPT(公司网关 / OpenAI 官方)──────────────────────
OPENAI_API_KEY=
# 公司内网网关(仅供参考,以团队实际下发为准):
# OPENAI_BASE_URL=https://llm-gw.jd.local/v1
# 可选,覆盖默认模型(需支持图片输入的视觉模型)
# OPENAI_MODEL=gpt-4o
